@model StaffCore_RD.Models.LoginViewModel

@{
    ViewData["Title"] = "Iniciar sesión — StaffCore RD";
}

<div class="row justify-content-center">
    <div class="col-md-5 col-lg-4">

        <div class="card shadow-sm mt-5">
            <div class="card-header bg-dark text-white text-center py-3">
                <h1 class="h4 mb-0">
                    <i class="bi bi-person-lock me-2"></i>Iniciar sesión
                </h1>
            </div>
            <div class="card-body p-4">

                <form asp-action="Login" asp-controller="Account" method="post">
                    <input type="hidden" name="returnUrl" value="@ViewData["ReturnUrl"]" />
                    @Html.AntiForgeryToken()

                    @* Errores generales del servidor (credenciales incorrectas / cuenta bloqueada) *@
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2" role="alert"></div>

                    <div class="mb-3">
                        <label asp-for="Email" class="form-label fw-semibold"></label>
                        <input asp-for="Email" class="form-control" placeholder="correo@ejemplo.com" autocomplete="username" />
                        <span asp-validation-for="Email" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Password" class="form-label fw-semibold"></label>
                        <input asp-for="Password" class="form-control" placeholder="••••••••" autocomplete="current-password" />
                        <span asp-validation-for="Password" class="text-danger small"></span>
                    </div>

                    <div class="mb-3 form-check">
                        <input asp-for="RememberMe" class="form-check-input" />
                        <label asp-for="RememberMe" class="form-check-label">Recordarme</label>
                    </div>

                    <div class="d-grid">
                        <button type="submit" class="btn btn-dark btn-lg">Entrar</button>
                    </div>
                </form>

            </div>
            <div class="card-footer text-center py-3">
                <small>¿No tienes cuenta?
                    <a asp-action="Register" asp-controller="Account" class="fw-semibold">Regístrate aquí</a>
                </small>
            </div>
        </div>

    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
