@model StaffCore_RD.Models.RegisterViewModel

@{
    ViewData["Title"] = "Registrarse — StaffCore RD";
}

<div class="row justify-content-center">
    <div class="col-md-6 col-lg-5">

        <div class="card shadow-sm mt-5">
            <div class="card-header bg-dark text-white text-center py-3">
                <h1 class="h4 mb-0">
                    <i class="bi bi-person-plus me-2"></i>Crear cuenta
                </h1>
            </div>
            <div class="card-body p-4">

                <form asp-action="Register" asp-controller="Account" method="post">
                    @Html.AntiForgeryToken()

                    @* Errores generales del servidor (ej. contraseña no cumple política de Identity) *@
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2" role="alert"></div>

                    <div class="mb-3">
                        <label asp-for="Email" class="form-label fw-semibold"></label>
                        <input asp-for="Email" class="form-control" placeholder="correo@ejemplo.com" autocomplete="username" />
                        <span asp-validation-for="Email" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Password" class="form-label fw-semibold"></label>
                        <input asp-for="Password" class="form-control" placeholder="Mínimo 8 caracteres" autocomplete="new-password" />
                        <span asp-validation-for="Password" class="text-danger small"></span>
                        <div class="form-text">Debe tener al menos 8 caracteres, una mayúscula, una minúscula y un número.</div>
                    </div>

                    <div class="mb-3">
                        <label asp-for="ConfirmPassword" class="form-label fw-semibold"></label>
                        <input asp-for="ConfirmPassword" class="form-control" placeholder="Repite tu contraseña" autocomplete="new-password" />
                        <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                    </div>

                    <div class="d-grid">
                        <button type="submit" class="btn btn-dark btn-lg">Crear cuenta</button>
                    </div>
                </form>

            </div>
            <div class="card-footer text-center py-3">
                <small>¿Ya tienes cuenta?
                    <a asp-action="Login" asp-controller="Account" class="fw-semibold">Inicia sesión</a>
                </small>
            </div>
        </div>

    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
