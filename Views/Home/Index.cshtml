@{
    ViewData["Title"] = "StaffCore RD — Gestión de Personal";
}

<div class="px-4 py-5 text-center">
    <div class="mb-4">
        <i class="bi bi-people-fill display-1 text-dark"></i>
    </div>
    <h1 class="display-5 fw-bold">StaffCore RD</h1>
    <div class="col-lg-6 mx-auto">
        <p class="lead mb-4 text-muted">
            Sistema de gestión de personal para empresas dominicanas.
            Administra empleados, departamentos y nómina de forma segura y eficiente.
        </p>

        @if (User.Identity!.IsAuthenticated)
        {
            <div class="alert alert-success d-inline-block px-4" role="alert">
                <i class="bi bi-check-circle me-2"></i>
                Bienvenido/a, <strong>@User.Identity.Name</strong>
            </div>
            <div class="mt-3">
                <a asp-controller="Staff" asp-action="Index" class="btn btn-dark btn-lg me-2">
                    <i class="bi bi-list-ul me-1"></i>Ver Personal
                </a>
                @if (User.IsInRole("Administrador") || User.IsInRole("RRHH"))
                {
                    <a asp-controller="Staff" asp-action="Create" class="btn btn-outline-dark btn-lg">
                        <i class="bi bi-person-plus me-1"></i>Nuevo Empleado
                    </a>
                }
            </div>
        }
        else
        {
            <div class="d-flex gap-3 justify-content-center">
                <a asp-controller="Account" asp-action="Login" class="btn btn-dark btn-lg">
                    <i class="bi bi-box-arrow-in-right me-1"></i>Iniciar sesión
                </a>
                <a asp-controller="Account" asp-action="Register" class="btn btn-outline-dark btn-lg">
                    <i class="bi bi-person-plus me-1"></i>Registrarse
                </a>
            </div>
        }
    </div>
</div>

<hr class="my-5" />

<div class="row g-4 text-center mb-4">
    <div class="col-md-4">
        <div class="card h-100 shadow-sm border-0">
            <div class="card-body py-4">
                <i class="bi bi-shield-lock-fill fs-1 text-dark mb-3 d-block"></i>
                <h5 class="fw-bold">Acceso por roles</h5>
                <p class="text-muted small">Administrador, RRHH y Viewer con permisos diferenciados para cada operación.</p>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card h-100 shadow-sm border-0">
            <div class="card-body py-4">
                <i class="bi bi-table fs-1 text-dark mb-3 d-block"></i>
                <h5 class="fw-bold">Gestión completa</h5>
                <p class="text-muted small">Alta, edición y baja de empleados con validaciones estrictas en todos los campos.</p>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card h-100 shadow-sm border-0">
            <div class="card-body py-4">
                <i class="bi bi-bar-chart-fill fs-1 text-dark mb-3 d-block"></i>
                <h5 class="fw-bold">Resumen estadístico</h5>
                <p class="text-muted small">Total de nómina en tiempo real por departamento: Tecnología, RRHH, Finanzas y Operaciones.</p>
            </div>
        </div>
    </div>
</div>
