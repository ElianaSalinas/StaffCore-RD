@model IEnumerable<StaffCore_RD.Models.Staff>

@{
    ViewData["Title"] = "Personal activo — StaffCore RD";
    var buscar = ViewData["BuscarActual"] as string;
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2 class="mb-0"><i class="bi bi-people me-2"></i>Personal activo</h2>

    @if (User.IsInRole("Administrador") || User.IsInRole("RRHH"))
    {
        <a asp-action="Create" class="btn btn-dark">
            <i class="bi bi-plus-lg me-1"></i>+ Nuevo
        </a>
    }
</div>

@* Buscador en tiempo real (bonus HU-10) *@
<div class="mb-3">
    <form asp-action="Index" method="get" class="d-flex gap-2">
        <div class="input-group">
            <span class="input-group-text"><i class="bi bi-search"></i></span>
            <input type="search" name="buscar" value="@buscar"
                   class="form-control" placeholder="Buscar por nombre…"
                   id="inputBuscar" />
        </div>
        <button type="submit" class="btn btn-outline-dark">Buscar</button>
        @if (!string.IsNullOrWhiteSpace(buscar))
        {
            <a asp-action="Index" class="btn btn-outline-secondary">Limpiar</a>
        }
    </form>
</div>

@if (!Model.Any())
{
    <div class="alert alert-info" role="alert">
        <i class="bi bi-info-circle me-2"></i>
        @if (!string.IsNullOrWhiteSpace(buscar))
        {
            <span>No se encontró personal con ese nombre.</span>
        }
        else
        {
            <span>Aún no hay personal registrado.</span>
        }
    </div>
}
else
{
    <div class="table-responsive">
        <table class="table table-striped table-hover align-middle">
            <thead class="table-dark">
                <tr>
                    <th>Nombre</th>
                    <th>Cargo</th>
                    <th>Departamento</th>
                    <th class="text-end">Salario</th>
                    <th class="text-end">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var empleado in Model)
                {
                    <tr>
                        <td>@empleado.Nombre</td>
                        <td>@empleado.Cargo</td>
                        <td>@empleado.Departamento</td>
                        <td class="text-end">RD$ @empleado.Salario.ToString("N2")</td>
                        <td class="text-end">
                            <div class="btn-group btn-group-sm">
                                @* Details — todos los roles *@
                                <a asp-action="Details" asp-route-id="@empleado.Id"
                                   class="btn btn-outline-secondary" title="Ver detalle">
                                    <i class="bi bi-eye"></i>
                                </a>

                                @* Editar — solo Admin y RRHH *@
                                @if (User.IsInRole("Administrador") || User.IsInRole("RRHH"))
                                {
                                    <a asp-action="Edit" asp-route-id="@empleado.Id"
                                       class="btn btn-outline-primary" title="Editar">
                                        <i class="bi bi-pencil"></i>
                                    </a>
                                }

                                @* Eliminar — solo Admin *@
                                @if (User.IsInRole("Administrador"))
                                {
                                    <a asp-action="Delete" asp-route-id="@empleado.Id"
                                       class="btn btn-outline-danger" title="Eliminar">
                                        <i class="bi bi-trash"></i>
                                    </a>
                                }
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
            <tfoot class="table-light fw-bold">
                <tr>
                    <td colspan="3">Total de nómina (@Model.Count() empleados)</td>
                    <td class="text-end">RD$ @Model.Sum(s => s.Salario).ToString("N2")</td>
                    <td></td>
                </tr>
            </tfoot>
        </table>
    </div>

    @if (User.IsInRole("Administrador") || User.IsInRole("RRHH"))
    {
        <div class="mt-2">
            <a asp-action="Resumen" class="btn btn-outline-dark btn-sm">
                <i class="bi bi-bar-chart me-1"></i>Resumen por departamento
            </a>
        </div>
    }
}
