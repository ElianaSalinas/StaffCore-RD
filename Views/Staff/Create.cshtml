@model StaffCore_RD.Models.Staff

@{
    ViewData["Title"] = "Nuevo empleado — StaffCore RD";
}

<div class="row justify-content-center">
    <div class="col-md-8 col-lg-7">

        <div class="d-flex justify-content-between align-items-center mb-3">
            <h2><i class="bi bi-person-plus me-2"></i>Nuevo empleado</h2>
            <a asp-action="Index" class="btn btn-outline-secondary btn-sm">
                <i class="bi bi-arrow-left me-1"></i>Volver al listado
            </a>
        </div>

        <div class="card shadow-sm">
            <div class="card-body p-4">

                <form asp-action="Create" method="post">
                    @Html.AntiForgeryToken()
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2" role="alert"></div>

                    <div class="row">
                        <div class="col-md-12 mb-3">
                            <label asp-for="Nombre" class="form-label fw-semibold"></label>
                            <input asp-for="Nombre" class="form-control" placeholder="Nombre completo del empleado" />
                            <span asp-validation-for="Nombre" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label asp-for="Cedula" class="form-label fw-semibold"></label>
                            <input asp-for="Cedula" class="form-control" placeholder="001-0000000-0" />
                            <span asp-validation-for="Cedula" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label asp-for="Departamento" class="form-label fw-semibold"></label>
                            <select asp-for="Departamento" class="form-select">
                                <option value="">-- Selecciona un departamento --</option>
                                <option value="Tecnología">Tecnología</option>
                                <option value="Recursos Humanos">Recursos Humanos</option>
                                <option value="Finanzas">Finanzas</option>
                                <option value="Operaciones">Operaciones</option>
                            </select>
                            <span asp-validation-for="Departamento" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label asp-for="Cargo" class="form-label fw-semibold"></label>
                            <input asp-for="Cargo" class="form-control" placeholder="Ej: Analista de Sistemas" />
                            <span asp-validation-for="Cargo" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label asp-for="Salario" class="form-label fw-semibold"></label>
                            <div class="input-group">
                                <span class="input-group-text">RD$</span>
                                <input asp-for="Salario" class="form-control" placeholder="23223.00" />
                            </div>
                            <span asp-validation-for="Salario" class="text-danger small"></span>
                            <div class="form-text">Mínimo RD$23,223.00</div>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label asp-for="FechaIngreso" class="form-label fw-semibold"></label>
                            <input asp-for="FechaIngreso" type="date" class="form-control" />
                            <span asp-validation-for="FechaIngreso" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6 mb-3 d-flex align-items-end">
                            <div class="form-check mb-2">
                                <input asp-for="Activo" class="form-check-input" />
                                <label asp-for="Activo" class="form-check-label">Activo</label>
                            </div>
                        </div>
                    </div>

                    <div class="d-flex gap-2 mt-2">
                        <button type="submit" class="btn btn-dark">
                            <i class="bi bi-floppy me-1"></i>Guardar empleado
                        </button>
                        <a asp-action="Index" class="btn btn-outline-secondary">
                            <i class="bi bi-x-lg me-1"></i>Cancelar
                        </a>
                    </div>
                </form>

            </div>
        </div>

    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
