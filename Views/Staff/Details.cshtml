@model StaffCore_RD.Models.Staff

@{
    ViewData["Title"] = $"{Model.Nombre} — Detalle — StaffCore RD";
}

<div class="row justify-content-center">
    <div class="col-md-8 col-lg-7">

        <div class="d-flex justify-content-between align-items-center mb-3">
            <h2><i class="bi bi-person-badge me-2"></i>Perfil del empleado</h2>
            <a asp-action="Index" class="btn btn-outline-secondary btn-sm">
                <i class="bi bi-arrow-left me-1"></i>Volver al listado
            </a>
        </div>

        <div class="card shadow-sm">
            <div class="card-header bg-dark text-white">
                <strong>@Model.Nombre</strong>
                @if (Model.Activo)
                {
                    <span class="badge bg-success ms-2">Activo</span>
                }
                else
                {
                    <span class="badge bg-secondary ms-2">Inactivo</span>
                }
            </div>
            <div class="card-body">
                <dl class="row">
                    <dt class="col-sm-4"><i class="bi bi-card-text me-1"></i>Cédula</dt>
                    <dd class="col-sm-8">@Model.Cedula</dd>

                    <dt class="col-sm-4"><i class="bi bi-briefcase me-1"></i>Cargo</dt>
                    <dd class="col-sm-8">@Model.Cargo</dd>

                    <dt class="col-sm-4"><i class="bi bi-building me-1"></i>Departamento</dt>
                    <dd class="col-sm-8">@Model.Departamento</dd>

                    <dt class="col-sm-4"><i class="bi bi-currency-dollar me-1"></i>Salario</dt>
                    <dd class="col-sm-8">RD$ @Model.Salario.ToString("N2")</dd>

                    <dt class="col-sm-4"><i class="bi bi-calendar-event me-1"></i>Fecha de ingreso</dt>
                    <dd class="col-sm-8">@Model.FechaIngreso.ToString("dd/MM/yyyy")</dd>
                </dl>
            </div>
            <div class="card-footer d-flex gap-2">
                @if (User.IsInRole("Administrador") || User.IsInRole("RRHH"))
                {
                    <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-outline-primary btn-sm">
                        <i class="bi bi-pencil me-1"></i>Editar
                    </a>
                }
                <a asp-action="Index" class="btn btn-outline-secondary btn-sm">
                    <i class="bi bi-list-ul me-1"></i>Volver al listado
                </a>
            </div>
        </div>

    </div>
</div>
