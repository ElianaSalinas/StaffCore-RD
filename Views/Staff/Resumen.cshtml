@model IEnumerable<StaffCore_RD.Models.ResumenDepartamentoViewModel>

@{
    ViewData["Title"] = "Resumen por departamento — StaffCore RD";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2><i class="bi bi-bar-chart-fill me-2"></i>Resumen por departamento</h2>
    <a asp-action="Index" class="btn btn-outline-secondary btn-sm">
        <i class="bi bi-arrow-left me-1"></i>Volver al listado
    </a>
</div>

<div class="row g-4">
    @foreach (var item in Model)
    {
        <div class="col-md-6">
            <div class="card shadow-sm h-100">
                <div class="card-header bg-dark text-white">
                    <i class="bi bi-building me-2"></i><strong>@item.Departamento</strong>
                </div>
                <div class="card-body">
                    <div class="row text-center">
                        <div class="col-6">
                            <div class="fs-1 fw-bold text-primary">@item.TotalEmpleados</div>
                            <small class="text-muted">Empleados activos</small>
                        </div>
                        <div class="col-6">
                            <div class="fs-4 fw-bold text-success">RD$ @item.TotalNomina.ToString("N2")</div>
                            <small class="text-muted">Total nómina</small>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }
</div>

<div class="mt-4">
    <div class="card shadow-sm">
        <div class="card-body">
            <strong>Total general:</strong>
            @Model.Sum(x => x.TotalEmpleados) empleados —
            RD$ @Model.Sum(x => x.TotalNomina).ToString("N2") en nómina
        </div>
    </div>
</div>
