@model StaffCore_RD.Models.Staff

@{
    ViewData["Title"] = "Confirmar eliminación — StaffCore RD";
}

<div class="row justify-content-center">
    <div class="col-md-7 col-lg-6">

        <div class="d-flex justify-content-between align-items-center mb-3">
            <h2 class="text-danger"><i class="bi bi-trash me-2"></i>Eliminar empleado</h2>
            <a asp-action="Index" class="btn btn-outline-secondary btn-sm">
                <i class="bi bi-arrow-left me-1"></i>Volver al listado
            </a>
        </div>

        @* Advertencia visible — exigida en la rúbrica *@
        <div class="alert alert-danger" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i>
            <strong>¿Seguro que deseas eliminar a @Model.Nombre?</strong>
            Esta acción eliminará permanentemente el registro y no se puede deshacer.
        </div>

        @* Card con los datos del empleado en modo lectura *@
        <div class="card border-danger shadow-sm mb-4">
            <div class="card-header bg-danger text-white fw-bold">
                <i class="bi bi-person me-2"></i>Datos del empleado
            </div>
            <div class="card-body">
                <dl class="row mb-0">
                    <dt class="col-sm-4">Nombre</dt>
                    <dd class="col-sm-8">@Model.Nombre</dd>

                    <dt class="col-sm-4">Cédula</dt>
                    <dd class="col-sm-8">@Model.Cedula</dd>

                    <dt class="col-sm-4">Cargo</dt>
                    <dd class="col-sm-8">@Model.Cargo</dd>

                    <dt class="col-sm-4">Departamento</dt>
                    <dd class="col-sm-8">@Model.Departamento</dd>

                    <dt class="col-sm-4">Salario</dt>
                    <dd class="col-sm-8">RD$ @Model.Salario.ToString("N2")</dd>

                    <dt class="col-sm-4">Fecha de ingreso</dt>
                    <dd class="col-sm-8">@Model.FechaIngreso.ToString("dd/MM/yyyy")</dd>
                </dl>
            </div>
        </div>

        <div class="d-flex gap-2">
            @* Cancelar primero — no debe ser el elemento con foco automático *@
            <a asp-action="Index" class="btn btn-secondary">
                <i class="bi bi-x-lg me-1"></i>Cancelar
            </a>

            @* Confirmar eliminación (POST) — botón rojo *@
            <form asp-action="Delete" asp-route-id="@Model.Id" method="post">
                @Html.AntiForgeryToken()
                <button type="submit" class="btn btn-danger">
                    <i class="bi bi-trash me-1"></i>Confirmar eliminación
                </button>
            </form>
        </div>

    </div>
</div>
